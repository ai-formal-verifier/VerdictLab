      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines the PRK_2e computation from the ephemeral Diffie-Hellman secret and its role in the run."
    },
    "4.1.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines how the responder’s static Diffie-Hellman authentication conditionally contributes to PRK_3e2m."
    },
    "4.1.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines how the initiator’s static Diffie-Hellman authentication conditionally contributes to PRK_4x3m."
    },
    "4.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies the protocol’s transcript-bound derivation of message keys, IVs, and MACs."
    },
    "4.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines application key export from the protocol’s final key and transcript hash."
    },
    "4.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines the stateful key-update operation, including nonce agreement and replacement of the stored key."
    },
