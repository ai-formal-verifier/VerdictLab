        "handshake"
      ],
      "reason": "Outlines the initiator-responder exchange, authentication data, derived secrets, and added protocol mechanisms relevant to the run."
    },
    "3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": ""
    },
    "3.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies the parties, message sequence, optional message four, and when application keys become available."
    },
    "3.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines the authentication modes independently chosen for the initiator and responder and their effect on the protocol."
    },
    "3.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": ""
    },
    "3.3.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies how each party chooses and exchanges connection identifiers that persist through the protocol."
    },
    "3.3.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": ""
    },
    "3.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": ""
    },
    "3.4.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Describes how connection identifiers and transport correlation associate received messages with protocol state."
    },
    "3.5": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines authentication credentials and keys, their prior availability and their uses in authentication and key derivation."
    },
    "3.5.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies identity and trust-anchor inputs and the parties’ identity authorization checks."
    },
    "3.5.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines the permissible authentication key types and their role-dependent use in the protocol."
    },
    "3.5.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines the credentials used by each party and the credential agreement needed for integrity verification."
    },
    "3.5.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies how credentials are identified and retrieved by the peer during the message exchange."
    },
    "3.6": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines cipher-suite contents and the supported-suite ordering and selection used in negotiation."
    },
    "3.7": {
      "subprotocols": [
        "handshake"
      ],
      "reason": ""
    },
    "3.8": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines optional authorization data fields, which messages carry them, and whether they are protected."
    },
    "3.9": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies the parameters parties must agree on and the checks and processing governed by that agreement."
    },
