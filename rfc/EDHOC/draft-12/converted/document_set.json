    },
    "5.2.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies initiator behavior, fresh ephemeral-key generation, identifier state, and cipher-suite selection."
    },
    "5.2.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies responder checks and branching on message one and the resulting failure path."
