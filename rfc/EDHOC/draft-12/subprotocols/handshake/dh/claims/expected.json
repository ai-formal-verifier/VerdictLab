{
  "vocab_version": "4.0.0",
  "protocol_id": "EDHOC-draft-12-handshake-dh",
  "names": {
    "G_I": "G_I, the Initiator's public authentication key when it authenticates with a static Diffie-Hellman key (the private key being I), contained in its authentication credential CRED_I (§3.5.2, §3.5.3).",
    "G_R": "G_R, the Responder's public authentication key when it authenticates with a static Diffie-Hellman key (the private key being R), contained in its authentication credential CRED_R (§3.5.2, §3.5.3).",
    "I": "The principal I: The Initiator: starts EDHOC, contributes its method, supported cipher suites, credential identifier and external authorization data, authenticates with its static Diffie-Hellman key, and verifies the Responder.",
    "R": "The principal R: The Responder: processes message_1, contributes its supported cipher suites, credential identifier and external authorization data, authenticates with its static Diffie-Hellman key, and verifies the Initiator.",
    "PRK_4x3m": "PRK_4x3m, the pseudorandom key Extract( PRK_3e2m, G_IY ) when the Initiator authenticates with a static Diffie-Hellman key (else PRK_3e2m), used to produce the MAC in message_3, to encrypt message_4 and to derive application specific data (§4.1.3, §4.3, §8.1)."
  },
