      ],
      "reason": ""
    },
    "4.4.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies initiator creation, signing, and encryption of message 3 using the derived protocol keys."
    },
    "4.4.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies responder state retrieval, decryption and signature verification of message 3, and failure handling."
    },
