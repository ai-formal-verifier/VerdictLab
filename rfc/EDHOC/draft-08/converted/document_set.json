    "2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Describes the parties, message flow, fresh session values, algorithm and curve negotiation, and protocol additions relevant to the handshake analysis."
    },
    "3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies the three-message exchange, authentication modes, application-data protection, and the point at which traffic keys become available."
    },
    "3.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": ""
    },
    "3.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines how the protocol derives message and application traffic keys and IVs from the negotiated inputs and exchange transcript."
    },
    "4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": ""
    },
    "4.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Describes asymmetric authentication roles and how credential identifiers resolve the parties' authentication keys."
    },
    "4.1.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": ""
