    },
    "4.2.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies initiator state and choices, including curve selection, ephemeral-key and nonce generation, session identifier handling, and construction of message 1."
    },
    "4.2.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies responder checks and failure behavior for message 1, including algorithm and curve negotiation and handling of application data."
    },
    "4.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": ""
    },
    "4.3.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": ""
    },
    "4.3.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies responder generation of ephemeral and session values, algorithm selection, and construction and protection of message 2."
    },
    "4.3.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies initiator state retrieval, negotiation and freshness checks, message 2 decryption and signature verification, and failure handling."
    },
    "4.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": ""
    },
    "4.4.1": {
      "subprotocols": [
