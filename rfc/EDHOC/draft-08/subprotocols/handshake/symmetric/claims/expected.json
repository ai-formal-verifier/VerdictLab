{
  "vocab_version": "4.0.0",
  "protocol_id": "EDHOC-draft-08-handshake-symmetric",
  "names": {
    "PSK": "The pre-shared uniformly random key that Party U and Party V are assumed to share, which Party V identifies by KID and which is the salt of the key derivation when EDHOC is authenticated with symmetric keys (§5.1, §3.2).",
    "K_2": "The key with which Party V encrypts COSE_ENC_2 of message_2 (AEAD_V with K_2 and IV_2), derived as in Section 3.2 (§3.2, §5.3.1, §5.3.2).",
    "APP_2'": "The payload of K_2's second use outside the protocol, introduced by assumption sym_key_reuse_V (key_reuse of K_2, the message_2 key of §3.2); not defined by the document.",
    "U": "The principal U: EDHOC initiator in the pre-shared-key mode. Holds the PSK shared with V, sends message_1 with its ephemeral DH share and the PSK identifier, and derives the OSCORE master secret.",
    "V": "The principal V: EDHOC responder in the pre-shared-key mode. Holds the same PSK, answers with its own ephemeral share in message_2, and derives the same OSCORE master secret. No signature key is used in this mode.",
    "E_U": "The ECDH ephemeral public key of Party U, sent in data_1 of message_1 and formatted as a COSE_Key (§2, §3.1, §5.2.1).",
    "E_V": "The ECDH ephemeral public key of Party V, sent in data_2 of message_2 on the same curve as E_U (§2, §5.3.1, §5.3.2).",
    "APP_1": "The opaque application data Party U may send unprotected in data_1 of message_1 (§3, §5.2.1).",
    "APP_2": "The opaque application data Party V sends as the plaintext of COSE_ENC_2 in message_2, encrypted and integrity protected under K_2 and, with symmetric keys, mutually authenticated (§3, §5.3.1, §5.3.2).",
    "APP_3": "The opaque application data Party U sends as the plaintext of COSE_ENC_3 in message_3, protected under K_3 and mutually authenticated (§3, §5.4.1, §5.4.2)."
  },
