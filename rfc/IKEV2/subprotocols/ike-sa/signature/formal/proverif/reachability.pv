(* ============================================================ *)
(*  IKEv2 reachability smoke test                               *)
(*                                                              *)
(*  PROVENANCE                                                  *)
(*  ----------                                                  *)
(*  Derived from this case's main.pv (the NICT AKE Zoo IKEv2    *)
(*  ProVerif model, IKE_SA_INIT key exchange + IKE_AUTH         *)
(*  signature authentication).  Same types, same cryptographic  *)
(*  primitives, same key schedule (prf+), same AUTH / SK_a* /   *)
(*  SK_e* message construction as main.pv.                      *)
(*                                                              *)
(*  WHAT CHANGED vs main.pv                                     *)
(*  -----------------------                                     *)
(*  - Security queries removed (no secrecy, no authentication   *)
(*    correspondence): this is purely a model-liveness check.   *)
(*  - The protocol messages travel over a PRIVATE channel `net` *)
(*    so the Dolev-Yao attacker cannot interfere; one honest    *)
(*    initiator (hostA) and one honest responder (hostB) run.   *)
(*  - The attacker key-registration process is dropped (only    *)
(*    honest principals participate).                           *)
(*  - secret_for_keys probes are dropped.                       *)
(*  - Terminal events end_init_IKE_AUTH / end_resp_IKE_AUTH are *)
(*    kept; on reaching them each role leaks a [private] token  *)
(*    on the public channel `c`.  query attacker(dbg_end_R)     *)
(*    therefore returns false exactly when the role's whole     *)
(*    modeled path (IKE_SA_INIT + IKE_AUTH) is executable.      *)
(*                                                              *)
(*  AUTHORITATIVE RESULTS (proverif reachability.pv)            *)
(*  ------------------------------------------------           *)
(*    RESULT not attacker(dbg_end_init[]) is false.            *)
(*    RESULT not attacker(dbg_end_resp[]) is false.            *)
(*  (false ⇒ token reachable ⇒ the IKE_SA_INIT + IKE_AUTH      *)
(*   handshake completes for that role: model is alive.)       *)
(* ============================================================ *)

free c: channel.                  (* public: only carries the reachability tokens *)
free net: channel [private].      (* private wire for the IKE_SA_INIT / IKE_AUTH messages *)

type host.
type nonce.
type skey.
type pkey.
type SPI_t.
type SA_t.

table keys(host, skey, pkey).

(* SIG *)
fun sign(bitstring, skey): bitstring.
fun pk(skey): pkey.
reduc forall x: bitstring, k: skey;
      check(sign(x, k), pk(k)) = x.

(* MAC and symmetric-key encryption *)
type symkey.
fun mac(bitstring, symkey): bitstring.
reduc forall k: symkey, x: bitstring;
      checkmac(mac(x, k), k) = x.

fun senc(bitstring, symkey): bitstring.
reduc forall k: symkey, x: bitstring;
      sdec(senc(x, k), k) = x.

type number.
const zero: number.
fun s(number): number. (* Successor *)

type spi.
const spi_zero: spi.

const null: bitstring.

type exchangeType.
const IKE_SA_INIT: exchangeType.
const IKE_AUTH: exchangeType.
const CREATE_CHILD_SA: exchangeType.
const INFORMATIONAL: exchangeType.

(* Diffie-Hellman *)
type G.
type exponent.
const g: G.
fun exp(G, exponent): G.
equation forall x: exponent, y: exponent;
      exp(exp(g, x), y) = exp(exp(g, y), x).

(* PRF *)
fun G_to_bs(G): bitstring [data, typeConverter].
fun host_to_bs(host): bitstring [data, typeConverter].
fun prf(bitstring, bitstring): bitstring.
fun prf_sk_d(bitstring, bitstring): bitstring.
fun prf_sk_ai(bitstring, bitstring): symkey.
fun prf_sk_ar(bitstring, bitstring): symkey.
fun prf_sk_ei(bitstring, bitstring): symkey.
fun prf_sk_er(bitstring, bitstring): symkey.
fun prf_sk_pi(bitstring, bitstring): bitstring.
fun prf_sk_pr(bitstring, bitstring): bitstring.

(* hosts *)
free hostA, hostB: host.

(* reachability tokens: leaked on public c only when a role completes *)
free dbg_end_init: bitstring [private].
free dbg_end_resp: bitstring [private].

(* terminal events (kept from main.pv) *)
event end_init_IKE_AUTH(host, host, SA_t, bitstring, bitstring, bitstring).
event end_resp_IKE_AUTH(host, host, SA_t, bitstring, bitstring, bitstring).

(* reachability queries: a "false" verdict means the token is reachable,
   i.e. the modeled handshake can run to completion for that role. *)
query attacker(dbg_end_init).
query attacker(dbg_end_resp).

let initiator(IDi: host, IDr: host, SAi1: SA_t, SAi2: SA_t, TSi: bitstring, TSr: bitstring) =
    if IDi = hostA || IDi = hostB then
    (*
        IKE_SA_INIT
        1. I->R: HDR, SAi1, KEi, Ni
        2. R->I: HDR, SAr1, KEr, Nr, [CERTREQ]
    *)
    new SPIi: number;
    new ei: exponent;
    let KEi1 = exp(g, ei) in
    new Ni: nonce;
    let ike_sa_init_request =
        ((SPIi, spi_zero, IKE_SA_INIT, zero), SAi1, KEi1, Ni) in
    out(net, ike_sa_init_request);
    in(net, ike_sa_init_response: bitstring);
    let ((=SPIi, SPIr: SPI_t, =IKE_SA_INIT, =zero), SAr1: SA_t,
         KEr1: G, Nr: nonce) = ike_sa_init_response in
    (*
        SKEYSEED = prf(Ni | Nr, g^ir)
        {SK_d | SK_ai | SK_ar | SK_ei | SK_er | SK_pi | SK_pr}
          = prf+(SKEYSEED, Ni | Nr | SPIi | SPIr)
    *)
    let SKEYSEED = prf((Ni, Nr), G_to_bs(exp(KEr1, ei))) in
    let SK_d = prf_sk_d(SKEYSEED, (Ni, Nr, SPIi, SPIr)) in
    let SK_ai = prf_sk_ai(SKEYSEED, (Ni, Nr, SPIi, SPIr)) in
    let SK_ar = prf_sk_ar(SKEYSEED, (Ni, Nr, SPIi, SPIr)) in
    let SK_ei = prf_sk_ei(SKEYSEED, (Ni, Nr, SPIi, SPIr)) in
    let SK_er = prf_sk_er(SKEYSEED, (Ni, Nr, SPIi, SPIr)) in
    let SK_pi = prf_sk_pi(SKEYSEED, (Ni, Nr, SPIi, SPIr)) in
    let SK_pr = prf_sk_pr(SKEYSEED, (Ni, Nr, SPIi, SPIr)) in
    (*
        IKE_AUTH
        3. I->R: HDR, SK {IDi, [CERT,] [CERTREQ,] [IDr,] AUTH, SAi2, TSi, TSr}
        4. R->I: HDR, SK {IDr, [CERT,] AUTH, SAr2, TSi, TSr}
    *)
    if SAi1 = SAr1 then
    get keys(=IDi, ski, pki) in
    let AUTHi = sign((ike_sa_init_request, Nr, prf(SK_pi, host_to_bs(IDi))), ski) in
    out(net, mac(senc((IDi, AUTHi, SAi2, TSi, TSr), SK_ei), SK_ai));
    in(net, mct: bitstring);
    let (=IDr, AUTHr: bitstring, =SAi2, =TSi, =TSr) =
        sdec(checkmac(mct, SK_ar), SK_er) in
    get keys(=IDr, skr, pkr) in
    if (ike_sa_init_response, Ni, prf(SK_pr, host_to_bs(IDr))) = check(AUTHr, pkr) then
    if IDr = hostA || IDr = hostB then
    event end_init_IKE_AUTH(IDi, IDr, SAi2, TSi, TSr, SKEYSEED);
    out(c, dbg_end_init).

let responder(IDi: host, IDr: host, SAr1: SA_t, SAr2: SA_t) =
    if IDr = hostA || IDr = hostB then
    (*
        IKE_SA_INIT
        1. I->R: HDR, SAi1, KEi, Ni
        2. R->I: HDR, SAr1, KEr, Nr, [CERTREQ]
    *)
    in(net, ike_sa_init_request: bitstring);
    let ((SPIi: bitstring, =spi_zero, =IKE_SA_INIT, =zero),
         SAi1: SA_t, KEi: G, Ni: nonce) = ike_sa_init_request in
    new SPIr: number;
    new er: exponent;
    new Nr: nonce;
    let ike_sa_init_response =
        ((SPIi, SPIr, IKE_SA_INIT, zero), SAr1, exp(g, er), Nr) in
    let SKEYSEED = prf((Ni, Nr), G_to_bs(exp(KEi, er))) in
    let SK_d = prf_sk_d(SKEYSEED, (Ni, Nr, SPIi, SPIr)) in
    let SK_ai = prf_sk_ai(SKEYSEED, (Ni, Nr, SPIi, SPIr)) in
    let SK_ar = prf_sk_ar(SKEYSEED, (Ni, Nr, SPIi, SPIr)) in
    let SK_ei = prf_sk_ei(SKEYSEED, (Ni, Nr, SPIi, SPIr)) in
    let SK_er = prf_sk_er(SKEYSEED, (Ni, Nr, SPIi, SPIr)) in
    let SK_pi = prf_sk_pi(SKEYSEED, (Ni, Nr, SPIi, SPIr)) in
    let SK_pr = prf_sk_pr(SKEYSEED, (Ni, Nr, SPIi, SPIr)) in
    out(net, ike_sa_init_response);
    (*
        IKE_AUTH
        3. I->R: HDR, SK {IDi, [CERT,] [CERTREQ,] [IDr,] AUTH, SAi2, TSi, TSr}
        4. R->I: HDR, SK {IDr, [CERT,] AUTH, SAr2, TSi, TSr}
    *)
    in(net, mct2: bitstring);
    let (=IDi, AUTHi: bitstring, SAi2: SA_t, TSi: bitstring, TSr: bitstring) =
        sdec(checkmac(mct2, SK_ai), SK_ei) in
    get keys(=IDi, ski, pki) in
    if (ike_sa_init_request, Nr, prf(SK_pi, host_to_bs(IDi))) = check(AUTHi, pki) then
    get keys(=IDr, skr, pkr) in
    let AUTHr = sign((ike_sa_init_response, Ni, prf(SK_pr, host_to_bs(IDr))), skr) in
    out(net, mac(senc((IDr, AUTHr, SAr2, TSi, TSr), SK_er), SK_ar));
    if IDi = hostA || IDi = hostB then
    event end_resp_IKE_AUTH(IDi, IDr, SAr2, TSi, TSr, SKEYSEED);
    out(c, dbg_end_resp).

process
    new skA: skey;
    insert keys(hostA, skA, pk(skA));
    new skB: skey;
    insert keys(hostB, skB, pk(skB));
    new SA1: SA_t;
    new SA2: SA_t;
    new TSi: bitstring;
    new TSr: bitstring;
    ( initiator(hostA, hostB, SA1, SA2, TSi, TSr)
    | responder(hostA, hostB, SA1, SA2) )
