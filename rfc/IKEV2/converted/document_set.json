  "sections": {
    "1": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Describes IKE roles, exchange sequencing and repetition, message purposes, authentication and SA-establishment goals, making this overview core protocol flow."
    },
    "1.1": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": ""
    },
    "1.1.1": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": ""
    },
    "1.1.2": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": ""
    },
    "1.1.3": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": ""
    },
    "1.1.4": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": ""
    },
    "1.2": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Specifies the IKE_SA_INIT and IKE_AUTH messages, payload contents and order, key derivation context, authentication checks, retries, and failure branches."
    },
    "1.6": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines protocol terminology and normative requirement keywords; this is non-core terminology content and the section is mainly definitions."
    },
    "1.7": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": ""
    },
    "1.8": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": ""
    },
    "2": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Describes protocol behavior over the network, including message handling and requirements, so it contributes execution and state context to analysis."
    },
    "2.1": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines retransmission behavior, saved request/response state, and handling of initial-exchange retries."
    },
    "2.2": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines Message ID assignment, state counters, and their role in matching and replay protection."
    },
    "2.3": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Specifies negotiation and enforcement of outstanding-request windows and the resulting request-processing state."
    },
    "2.4": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines liveness checks, state deletion, and the effect of crash/restart and INITIAL_CONTACT notifications."
    },
    "2.5": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Specifies version negotiation, compatibility behavior, and branches for unsupported versions or payloads."
    },
    "2.6": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines SPI selection and cookie challenge/retry behavior, including responder state and validation."
    },
    "2.6.1": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Describes retry sequencing when cookie and Diffie-Hellman-group corrections interact."
    },
    "2.7": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines algorithm proposal structure and responder selection and rejection rules."
    },
    "2.10": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Specifies fresh nonce generation and how nonces participate in key derivation and freshness."
    },
    "2.11": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines address/port handling and response routing behavior."
    },
    "2.12": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Describes ephemeral Diffie-Hellman exponent lifecycle and reuse, including state deletion relevant to forward secrecy."
    },
    "2.13": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines how negotiated cryptographic choices determine key material generation, including the protocol's prf+ computation."
    },
    "2.14": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Specifies IKE SA key derivation from exchanged nonces, the Diffie-Hellman secret, and SPIs, and assigns derived keys to protocol uses."
    },
    "2.15": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines authentication inputs and AUTH computations for each peer, binding identities, nonces, and exchanged messages."
    },
    "2.16": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Specifies EAP authentication message sequencing, branching, and the resulting authentication and key use."
    },
    "2.17": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines Child SA key derivation from exchanged values and assignment of derived key material to negotiated SAs."
    },
    "2.19": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines configuration-address request and response exchanges, conditions, and failure behavior."
    },
    "2.21": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Specifies error response and state-cleanup behavior across protocol phases."
    },
    "2.21.1": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines error and retry handling before cryptographic protection is established."
    },
    "2.21.2": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines authentication and Child SA failure branches during IKE_AUTH and their effect on IKE SA state."
    },
    "2.21.3": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines error responses and fatal-state behavior after IKE SA authentication."
    },
    "2.21.4": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines handling of errors and notifications outside a known IKE SA, including actions and state preservation."
    },
    "2.23": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Specifies NAT detection, notification checks, address updates, and resulting UDP encapsulation behavior."
    },
    "2.23.1": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines transport-mode NAT traversal processing, traffic-selector substitutions, policy checks, and associated state."
    },
    "2.24": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": ""
    },
    "3": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Introduces the protocol's message and payload structures; these semantic message fields are core to formal modeling."
    },
    "3.1": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines IKE message header fields and their roles in exchange selection, peer role, matching, and processing."
    },
    "3.2": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines generic payload chaining and critical-payload handling that govern message interpretation and rejection."
    },
    "3.3": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines the semantic structure and negotiation behavior of SA proposals, transforms, and attributes."
    },
    "3.3.1": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": ""
    },
    "3.3.2": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": ""
    },
    "3.3.3": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": ""
    },
    "3.3.4": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": ""
    },
    "3.3.5": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": ""
    },
    "3.3.6": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Specifies offer selection, consistency checks, and rejection branches for SA and transform negotiation."
    },
    "3.4": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines the key-exchange payload and checks connecting its Diffie-Hellman group and value to the negotiation."
    },
    "3.5": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines identity payload semantics and their use in policy and authentication decisions."
    },
    "3.6": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines certificate payload contents and how certificates support authentication in protocol exchanges."
    },
    "3.7": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines certificate-request content and the conditions governing certificate selection and response."
    },
    "3.8": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines authentication payload content and the authentication methods it carries."
    },
    "3.9": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines nonce payload semantics and the fresh values carried during exchanges."
    },
    "3.10": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines notification message structure and its use for protocol status, errors, and capability signaling."
    },
    "3.10.1": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines notification meanings and the handling rules for recognized and unrecognized status and error types."
    },
    "3.11": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines deletion messages and how their protocol identifiers and SPIs identify state to remove."
    },
    "3.12": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": ""
    },
    "3.13": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines traffic-selector message content and the matching semantics used to specify protected flows."
    },
    "3.13.1": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": ""
    },
    "3.14": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines the encrypted payload's semantic contents and cryptographic protection processing for protocol messages."
    },
    "3.15": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines configuration-message exchange semantics for requesting and supplying peer configuration information."
    },
    "3.15.1": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines configuration attributes and the request/reply and push/ack exchange behavior."
    },
    "3.15.2": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Specifies how subnet configuration data affects traffic routing and creation of additional SAs."
    },
    "3.15.3": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": ""
    },
    "3.15.4": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines address-assignment failure notifications and the resulting IKE and Child SA branches."
    },
    "3.16": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines EAP payload message fields and the protocol-level request, response, success, and failure meanings."
    },
    "4": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "States required protocol capabilities and exchange behavior for conforming implementations, including supported roles and failure alternatives."
    },
    "5": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "States claimed security properties and protocol limitations, including authentication, secrecy, and exposure considerations."
    },
    "5.1": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Defines the authorization constraint linking authenticated identities and permitted traffic selectors for Child SA creation."
    },
    "C": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Summarizes the protocol exchange variants and the payloads that may occur in each message."
    },
    "C.1": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Lists IKE_SA_INIT message sequences and payload alternatives, including cookie and group-error branches."
    },
    "C.2": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Lists the IKE_AUTH exchange message structure and payload alternatives without EAP."
    },
    "C.3": {
      "subprotocols": [
        "ike-sa"
      ],
      "reason": "Lists the EAP-based IKE_AUTH message sequence, repetition, and final authentication and Child SA payloads."
    }
  },
