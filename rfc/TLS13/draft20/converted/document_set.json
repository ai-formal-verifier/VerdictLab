    "4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines handshake message structure, ordering, negotiation, checks, branches, authentication, and post-handshake state transitions central to the protocol run."
    },
    "4.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies how client and server exchange capabilities and establish traffic keys, including negotiation choices and failure branches."
    },
    "4.1.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines the offered parameter sets, server selection rules, compatibility checks, and resulting key-exchange and authentication modes."
    },
    "4.1.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies ClientHello contents, client randomness, retry behavior, server checks, and subsequent client actions."
    },
    "4.1.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines ServerHello fields, server choices, client validation, and downgrade detection checks."
    },
    "4.1.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies HelloRetryRequest conditions, fields, client checks, second-hello behavior, and cipher-suite consistency."
    },
    "4.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines extension message fields, where extensions may occur, request-response behavior, and checks on unsolicited or misplaced extensions."
    },
    "4.2.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies version preferences, server selection and rejection rules, and the version value sent in the handshake."
    },
    "4.2.1.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": ""
    },
    "4.2.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines cookie exchange and client copying behavior, including server state offload and retry processing."
    },
    "4.2.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies signature-algorithm offers and certificate/signature selection and validation constraints."
    },
    "4.2.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines certificate-authority information carried between endpoints and its role in guiding certificate selection."
    },
    "4.2.5": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines negotiation and conditions for post-handshake client authentication."
    },
    "4.2.6": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies supported-group offers, preference and use of peer group information across connections."
    },
    "4.2.7": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines key-share message variants, fresh exchange shares, selection, retry checks, and server/client consistency requirements."
    },
    "4.2.7.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies Diffie-Hellman share values and peer-public-key validity checks used in key establishment."
    },
    "4.2.7.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies ECDHE share values and peer-point validation used in key establishment."
    },
    "4.2.8": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines the client’s supported PSK exchange modes and the server’s mode-selection constraints."
    },
    "4.2.9": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies early-data negotiation, acceptance and rejection branches, consistency checks, and retransmission behavior."
    },
    "4.2.10": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines PSK identity and binder fields, PSK selection, binder validation, and client checks on the negotiated PSK."
    },
    "4.2.10.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies ticket-age state and computation used by the client when offering PSK identities."
    },
    "4.2.10.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines binder computation over the handshake transcript and the PSK-derived key inputs."
    },
    "4.2.10.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies the message processing order for streaming early data to avoid protocol deadlock."
    },
    "4.2.10.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines ticket-age validation state and server handling that constrains replay of early data."
    },
    "4.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies server parameter messages, their order, and their protection under handshake traffic keys."
    },
    "4.3.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines EncryptedExtensions transmission, contents, and client checks."
    },
    "4.3.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines CertificateRequest contents, sequencing, uniqueness and unpredictability of request context, and conditions for requesting client authentication."
    },
    "4.3.2.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines OID/value filters in CertificateRequest and the client certificate matching and server response rules."
    },
    "4.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies authentication message roles, transcript context, computed contents, and conditions for sending the messages."
    },
    "4.4.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines which handshake messages enter the transcript hash and how the retry transcript is transformed."
    },
    "4.4.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines certificate message structure, when certificates are sent, and certificate-chain content and checks."
    },
    "4.4.2.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies certificate status and SCT extension exchanges and their placement in certificate messages."
    },
    "4.4.2.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines server certificate selection and compatibility constraints based on the client’s offers and certificate properties."
    },
    "4.4.2.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines client certificate selection constraints in response to server-requested authentication parameters."
    },
    "4.4.2.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies receiver validation and failure or continuation branches for certificate messages."
    },
    "4.4.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines CertificateVerify message fields, signature input computation, algorithm checks, and receiver verification and failure handling."
    },
    "4.4.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines Finished key and transcript-MAC computation, receiver checks, and the transition to application traffic."
    },
    "4.5": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies the EndOfEarlyData message, when the client sends it, and how its receipt affects processing."
    },
    "4.6": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines post-handshake message use and protection under application traffic keys."
    },
    "4.6.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies server ticket issuance, client storage and reuse, ticket fields, and conditions for resumption."
    },
    "4.6.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines post-handshake authentication request-response flows, required messages, and request-context state."
    },
    "4.6.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines KeyUpdate message structure, triggers, key-generation changes, response behavior, and ordering checks."
    },
    "5": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines the record protocol’s message types, protection and delivery behavior, and unexpected-record failure handling."
    },
    "5.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies record framing and fragmentation, message ordering constraints, and content-specific handling."
    },
    "5.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines protected-record structure and the encryption/decryption computation, inputs, and failure branch."
    },
    "5.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies per-direction sequence-number state, update/reset rules, and nonce computation."
    },
    "5.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines record padding semantics, sender choices, receiver processing, and invalid-padding behavior."
    },
    "5.5": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "States limits on key use and the protocol response of updating traffic keys before reaching them."
    },
    "6": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines alert semantics, connection termination and secret deletion after errors, and parsing versus semantic failure branches."
    },
    "6.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies closure signaling, peer response, and handling of data after closure."
    },
    "6.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines error-alert conditions and the resulting abort and connection-closing behavior."
    },
    "7": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Describes protocol input secrets and their combination with the handshake transcript to produce working keying material."
    },
    "7.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines the key schedule, input-secret order, transcript-dependent derivations, and values used for handshake and application traffic."
    },
    "7.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies application traffic-secret updates and deletion of prior key state."
    },
    "7.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines traffic-key and IV computations from traffic secrets and assigns secrets to record types."
