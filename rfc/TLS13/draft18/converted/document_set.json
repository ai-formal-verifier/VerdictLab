    "D": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "States the intended TLS security properties and their scope, including the distinction between handshake and record-layer guarantees."
    },
    "D.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "States handshake security goals and the claimed properties of certificate, PSK, resumption and 0-RTT modes."
    },
