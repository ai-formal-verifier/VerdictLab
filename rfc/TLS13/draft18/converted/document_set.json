  "sections": {
    "1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "States TLS security goals and the roles of handshake and record protocol, which are protocol security goals and execution components relevant to analysis."
    },
    "1.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": ""
    },
    "1.2": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": ""
    },
    "1.3": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": ""
    },
    "2": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Describes handshake roles, message flows, negotiation and key establishment, plus PSK resumption and early-data execution and its security guarantees."
    },
    "2.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies the retry branch and handshake restart when key shares are unacceptable, including abort conditions."
    },
    "2.2": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Describes PSK provisioning, ticket-based state across sessions, resumption negotiation, and optional combination with ephemeral key exchange."
    },
    "2.3": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies the 0-RTT mode, its parties, setup requirements, early messages, and its weaker replay and forward-secrecy guarantees."
    },
    "4": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines handshake message ordering and structures, with failure behavior for unexpected sequencing."
    },
    "4.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Describes key-exchange messages and how the parties exchange capabilities and establish traffic keys."
    },
    "4.1.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies negotiation inputs, server selection of algorithms and modes, and abort branches for unsupported parameters."
    },
    "4.1.2": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies ClientHello generation, retry behavior, fields and their semantics, client state, and validation branches."
    },
    "4.1.3": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies ServerHello fields, server choices and client checks, including downgrade-related branching."
    },
    "4.1.4": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines the HelloRetryRequest branch, its message content, client checks, and restarted ClientHello exchange."
    },
    "4.2": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines extension message semantics, placement and ordering rules, and checks governing their negotiation."
    },
    "4.2.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies supported-version offers, server selection, and client/server behavior when versions are missing or unknown."
    },
    "4.2.1.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": ""
    },
    "4.2.2": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines cookie state and its server-to-client round trip through a retry, including client echo behavior."
    },
    "4.2.3": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies signature algorithm offers and selection constraints that affect authentication branches."
    },
    "4.2.4": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies supported-group offers, preference state and the server's group information to the client."
    },
    "4.2.5": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines key-share message fields, fresh independent shares, group selection, retry processing, and validation branches."
    },
    "4.2.5.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies the finite-field Diffie-Hellman public values and peer validation checks used in key establishment."
    },
    "4.2.5.2": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies the elliptic-curve key-share values used in the handshake."
    },
    "4.2.6": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines PSK identity and binder fields, PSK selection and validation, and client checks on the server's selection."
    },
    "4.2.6.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies the binder's handshake-transcript inputs and computation, binding the PSK to this and any prior session."
    },
    "4.2.7": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines client-offered PSK exchange modes and the server's constraints on choosing PSK-only or PSK-DHE."
    },
    "4.2.8": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies early-data negotiation, ticket-age and parameter checks, acceptance or rejection branches, and the handling of early records."
    },
    "4.2.8.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies the order of client early-data transmission and the server response needed to avoid deadlock."
    },
    "4.2.8.2": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies the server's saved ticket-age state and checks used to bound cross-connection replay exposure."
    },
    "4.3": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines the server-parameter phase and its place in the handshake message sequence."
    },
    "4.3.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies when EncryptedExtensions is sent, its contents and client validation."
    },
    "4.3.2": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines client-authentication requests, their fields, and how the client certificate is constrained by the request."
    },
    "4.4": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies authentication-message inputs, computed signatures and MACs, transcript state, and the authentication sequence."
    },
    "4.4.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines when Certificate messages are sent and the certificate-chain data exchanged in authentication."
    },
    "4.4.1.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": ""
    },
    "4.4.1.2": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies server certificate selection constraints based on negotiated algorithms and client offers."
    },
    "4.4.1.3": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies client certificate selection constraints based on the server's authentication request."
    },
    "4.4.1.4": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines receiver checks and the continuation or abort branches for received certificates."
    },
    "4.4.2": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies CertificateVerify message contents, transcript-dependent signature computation, and algorithm checks."
    },
    "4.4.3": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies Finished key derivation and transcript MAC computation, verification and resulting transition to application data."
    },
    "4.5": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines the post-handshake message phase, its encryption state and constraints on message interleaving."
    },
    "4.5.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies ticket issuance, PSK derivation and storage for later resumption, including ticket-related state and use limits."
    },
    "4.5.2": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines post-handshake client-authentication requests and response/decline message paths."
    },
    "4.5.3": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines key-update messages, key-generation state changes, request/response behavior and validation branches."
    },
    "4.6": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies record-boundary checks governing transitions between handshake key states."
    },
    "5": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines the record protocol's message protection and delivery behavior, including record types, rejection rules and application-data handling."
    },
    "5.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies record fragmentation, coalescing, fields and size checks governing transport of protocol messages."
    },
    "5.2": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines encrypted record structure and the AEAD protection and deprotection computations, including failure handling."
    },
    "5.3": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies per-direction sequence-number state and its computation into nonces for record protection."
    },
    "5.4": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines record-padding behavior, receiver parsing and error branches."
    },
    "5.5": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "States key-usage limits and the resulting key-update requirement."
    },
    "6": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines alert exchanges and their effects on connection state, secret deletion and termination."
    },
    "6.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies closure and early-data termination alerts and the parties' close-handshake behavior."
    },
    "6.2": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines error alert conditions and the resulting abort and connection-termination behavior."
    },
    "7": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Introduces the protocol's keying inputs and their role in connection protection."
    },
    "7.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies the key schedule, its secret inputs, transcript-dependent computations and resulting traffic and resumption secrets."
    },
    "7.2": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines traffic-secret update computation and deletion of prior key state."
    },
    "7.3": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies how protocol traffic secrets determine per-purpose traffic keys and IVs."
    },
    "7.3.1": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies the Diffie-Hellman shared-secret computation and its use as a key-schedule input."
    },
    "7.3.2": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Specifies the ECDH key generation and shared-secret computations used by the key schedule."
    },
    "7.3.3": {
      "subprotocols": [
        "zero-rtt"
      ],
      "reason": "Defines exporter values computed from handshake-derived secrets and their context inputs."
    },
