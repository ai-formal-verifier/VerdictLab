    "4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines handshake message ordering and semantic fields, negotiation, computations, state transitions, and validation branches."
    },
    "4.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Describes negotiation messages and how peers select parameters and establish shared secrets."
    },
    "4.1.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies offered options, selection and failure branches, and the relationship between PSK and certificate authentication."
    },
    "4.1.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines ClientHello contents, client generation and update behavior, and server-side processing and checks."
    },
    "4.1.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines ServerHello fields, server generation, client checks, version selection, and downgrade handling."
    },
    "4.1.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies the retry exchange, client/server state changes, and required consistency checks."
    },
    "4.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines extension message structures and their request-response placement, processing constraints, and negotiation rules."
    },
    "4.2.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies version advertisement, selection, and validation by the client and server."
    },
    "4.2.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines cookie exchange and server retry/state handling."
    },
    "4.2.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies signature algorithm offers, selection constraints, and associated handshake checks."
    },
    "4.2.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines certificate-authority information exchanged to guide certificate selection."
    },
    "4.2.5": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies certificate filters, client matching behavior, and server handling of an unsatisfied request."
    },
    "4.2.6": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines the client's opt-in state and server permission checks for post-handshake authentication."
    },
    "4.2.7": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies supported key-exchange groups and how the client and server use and validate that information."
    },
    "4.2.8": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines key-share message structures, generation, exchange, and peer consistency checks."
    },
    "4.2.8.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies finite-field key-share values and required peer public-key validation."
    },
    "4.2.8.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies elliptic-curve key-share values and required peer public-key validation."
    },
    "4.2.9": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines client-advertised PSK key-exchange modes and the server's permitted selection and key-share behavior."
    },
    "4.2.10": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies early-data negotiation, acceptance and rejection branches, associated state, and retransmission constraints."
    },
    "4.2.11": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines PSK identity and binder fields, their association with keys, and client/server validation and selection behavior."
    },
    "4.2.11.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies ticket-age state and its computation and use by the client and server."
    },
    "4.2.11.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies computation of PSK binders from the PSK and handshake transcript, including retry processing."
    },
    "4.2.11.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies the ordering of early-data and handshake processing needed to avoid deadlocks."
    },
    "4.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines server parameter messages and their place in the handshake under handshake traffic keys."
    },
    "4.3.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies EncryptedExtensions timing, contents, and client validation."
    },
    "4.3.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines certificate requests, their context and parameters, and when clients may be asked to authenticate."
    },
    "4.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies authentication messages, their transcript inputs, computed signatures and MACs, and flight ordering."
    },
    "4.4.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines which handshake messages form the transcript and how the transcript state changes on retry and post-handshake authentication."
    },
    "4.4.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines certificate message contents, sender conditions, and certificate-chain exchange behavior."
    },
    "4.4.2.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies the status and SCT information carried in certificate exchanges."
    },
    "4.4.2.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines server certificate selection constraints based on the client's offers and validation behavior."
    },
    "4.4.2.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines client certificate selection constraints based on server requests."
    },
    "4.4.2.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies receiver checks and the continuation or abort branches for certificate messages."
    },
    "4.4.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines CertificateVerify inputs and signature computation, algorithm checks, and receiver verification behavior."
    },
    "4.4.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines Finished computation and verification, key-confirmation behavior, and when application data may flow."
    },
    "4.5": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies when EndOfEarlyData is sent and received and the associated traffic-key transition."
    },
    "4.6": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines post-handshake message operation and protection under application traffic keys."
    },
    "4.6.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies session-ticket issuance, stored ticket state, ticket-derived PSKs, and resumption constraints."
    },
    "4.6.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines post-handshake client-authentication requests, responses, and ordering."
    },
    "4.6.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies KeyUpdate message exchange, traffic-secret state updates, and required processing order."
    },
    "5": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines the record protocol's message processing, record exchange rules, and record-type handling."
    },
    "5.1": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies record-layer message structure, fragmentation and ordering rules, and handling of compatibility records."
    },
    "5.2": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines record protection inputs and outputs and the decryption failure branch."
    },
    "5.3": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies sequence-number state and computation of each record nonce."
    },
    "5.4": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Defines padding generation and receiver processing and validation."
    },
    "5.5": {
      "subprotocols": [
        "handshake"
      ],
      "reason": "Specifies key-usage limits that govern when traffic keys should be updated."
    },
    "6": {
      "subprotocols": [
        "handshake"
      ],
