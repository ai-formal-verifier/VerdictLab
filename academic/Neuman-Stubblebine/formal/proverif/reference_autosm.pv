(* =====================================================================
   UPSTREAM PROVENANCE FILE — the original AutoSM-Tamarin export,
   verbatim. ``main.pv`` beside it is the untyped model that
   results.json records; see its header.

   This file uses TAGGED modeling (per-message s1..s6 constants),
   which gives different verdicts than the untyped model:
     - tagged    (this file): agreement_B = true,  agreement_A = false
     - untyped  (main.pv):    agreement_B = false, agreement_A = false
   Both are valid under their respective modeling commitments.

   Kept so the upstream AutoSM model stays reproducible: re-run it to
   confirm the tagged verdicts, ``diff`` against main.pv to see the
   de-tagging changes.
   ===================================================================== *)

(* =====================================================================
   Neuman-Stubblebine — ProVerif standard oracle.
   Provenance: generated by `tamarin-prover -m=proverif` from the SAPIC+
   model `Neuman-Stubblebine-P.spthy` (sourced from the AutoSM
   benchmark, GPL-3.0). Two minimal adaptations for ProVerif 2.05:
     (1) injectiveagreement_A/B queries rewritten from the tamarin
         time-variable encoding to ProVerif-native inj-event (semantics
         equivalent; verified to yield the same verdicts as the
         authoritative Tamarin proof);
     (2) the existential `executability` sanity query removed (tamarin
         encodes it with time inequalities in the premise, which 2.05
         rejects; it is verified in the Tamarin run, not a security goal).
   Authoritative verdicts (Tamarin & this file agree):
     noninj/inj agreement_B = true ; noninj/inj agreement_A = false
     secrecy = verified by Tamarin (tamarin export left it as a comment).
   Modeling-assumption caveat:
     This AutoSM model tags every encrypted message with distinct
     constants s1..s6, so the B->K instruction {A,N_a,T_b}K_kb and the
     ticket {A,K_ab,T_b}K_kb are non-confusable, hence agreement_B = true.
     A faithful UNTYPED extraction of the bare RFC-style spec (no per-
     message tags, as written in converted/main §4) is confusable: the
     instruction ciphertext can be replayed as the ticket, yielding the
     documented type-flaw/message-confusion attack (ref [3] Hwang 1995,
     [2] SPORE) and agreement_B = FALSE. The divergence is typed (this
     file) vs untyped (main.pv) modeling of the same protocol; secrecy
     and agreement_A still match.
   ===================================================================== *)
free att:channel.
free s1:bitstring.
free s2:bitstring.
free s3:bitstring.
free s4:bitstring.
free s5:bitstring.
free s6:bitstring.
fun fst(bitstring):bitstring.
fun id(bitstring):bitstring.
fun pair(bitstring,bitstring):bitstring.
fun senc(bitstring,bitstring):bitstring.
fun snd(bitstring):bitstring.
event eCommitA(bitstring,bitstring,bitstring).
event eCommitB(bitstring,bitstring,bitstring).
event eCompromise(bitstring).
event eIN_A_2(bitstring,bitstring).
event eIN_B(bitstring,bitstring).
event eIN_S_1(bitstring,bitstring).
event eOUT_A(bitstring).
event eOUT_B_1(bitstring).
event eOUT_S_2(bitstring).
event eRunningA(bitstring,bitstring,bitstring).
event eRunningB(bitstring,bitstring,bitstring).
event eSecret(bitstring,bitstring,bitstring).
event eServer(bitstring,bitstring,bitstring).
equation forall x_1:bitstring, x_2:bitstring;   fst((x_1, x_2)) = x_1.
equation forall x_1:bitstring, x_2:bitstring;   snd((x_1, x_2)) = x_2.
reduc forall k:bitstring, m:bitstring;   sdec(senc(m, k), k) = m.
(*AUTO_typing*)
(*∀ x m #i.
   (IN_S_1( m, x ) @ #i) ⇒
   ((∃ #j. (!KU( x ) @ #j) ∧ (#j < #i)) ∨
    (∃ #j. (OUT_B_1( m ) @ #j) ∧ (#j < #i)))*)

(* executability query removed: tamarin-export encodes it with time
   inequalities in the premise, which ProVerif 2.05 rejects; it is an
   existential model-sanity lemma (verified in the Tamarin run), not a
   security goal. *)

(* Existential lemma executability has a leading negation, interpret ProVerif's answers accordingly!*)

(*secrecy*)
(*∀ A B k #i.
   (Secret( A, B, k ) @ #i) ⇒
   (((¬(∃ #j. K( k ) @ #j)) ∨ (∃ #j. Compromise( B ) @ #j)) ∨
    (∃ #j. Compromise( A ) @ #j))*)

(*noninjectiveagreement_B*)
query A:bitstring, B:bitstring, t:bitstring, i:time, j:time, r:time;
 (event(eCommitB( B, A, t ))@i) ==>
 ((((event(eRunningA( A, B, t ))@j) && (j < i)) ||
   (event(eCompromise( A ))@r)) ||
  (event(eCompromise( B ))@r))
.

(*noninjectiveagreement_A*)
query A:bitstring, B:bitstring, t:bitstring, i:time, j:time, r:time;
 (event(eCommitA( A, B, t ))@i) ==>
 ((((event(eRunningB( B, A, t ))@j) && (j < i)) ||
   (event(eCompromise( A ))@r)) ||
  (event(eCompromise( B ))@r))
.

(*injectiveagreement_B*)
query A:bitstring, B:bitstring, t:bitstring;
 inj-event(eCommitB( B, A, t )) ==>
 (inj-event(eRunningA( A, B, t )) ||
  event(eCompromise( A )) ||
  event(eCompromise( B )))
.

(*injectiveagreement_A*)
query A:bitstring, B:bitstring, t:bitstring;
 inj-event(eCommitA( A, B, t )) ==>
 (inj-event(eRunningB( B, A, t )) ||
  event(eCompromise( A )) ||
  event(eCompromise( B )))
.

let Alice(Kas_2:bitstring, idA_2:bitstring, idB_2:bitstring)=
    new Na_2:bitstring;
    out(att,(idA_2, Na_2));
    in(att,(cypher1_2:bitstring, (cypher2_2:bitstring, Nb_2:bitstring)));
    let mess1_2:bitstring=sdec(cypher1_2, Kas_2) in
    let (=s2, (=idB_2, (=Na_2, (Kab_2:bitstring, Tb_2:bitstring))))=mess1_2 in
    event eIN_A_2( cypher1_2, Tb_2 );
    event eCommitA( idA_2, idB_2, (Na_2, (Nb_2, Tb_2)) );
    event eRunningA( idA_2, idB_2, (Kab_2, (Na_2, Nb_2)) );
    event eSecret( idA_2, idB_2, Kab_2 );
    event eOUT_A( senc((s4, Nb_2), Kab_2) );
    out(att,(cypher2_2, senc((s4, Nb_2), Kab_2)));
    new Ma_2:bitstring;
    out(att,(cypher2_2, Ma_2));
    in(att,(cypher6_2:bitstring, Mb_2:bitstring));
    let (=s5, =Ma_2)=sdec(cypher6_2, Kab_2) in
    let cypher7_2:bitstring=senc((s6, Mb_2), Kab_2) in
    out(att,cypher7_2).
let Bob(Kbs_2:bitstring, idA_2:bitstring, idB_2:bitstring)=
    in(att,(=idA_2, Na_2:bitstring));
    new Nb_2:bitstring;
    new Tb_2:bitstring;
    event eRunningB( idB_2, idA_2, (Na_2, (Nb_2, Tb_2)) );
    event eOUT_B_1( senc((s1, (idA_2, (Na_2, Tb_2))), Kbs_2) );
    out(att,(idB_2, (Nb_2, senc((s1, (idA_2, (Na_2, Tb_2))), Kbs_2))));
    in(att,(cypher3_2:bitstring, cypher4_2:bitstring));
    let mess2_2:bitstring=sdec(cypher3_2, Kbs_2) in
    let (=s3, (=idA_2, (Kab_2:bitstring, =Tb_2)))=mess2_2 in
    let (=s4, =Nb_2)=sdec(cypher4_2, Kab_2) in
    event eIN_B( cypher4_2, Nb_2 );
    event eCommitB( idB_2, idA_2, (Kab_2, (Na_2, Nb_2)) );
    event eSecret( idB_2, idA_2, Kab_2 );
    in(att,(=cypher3_2, Ma_2:bitstring));
    new Mb_2:bitstring;
    let cypher6_2:bitstring=senc((s5, Ma_2), Kab_2) in
    out(att,(cypher6_2, Mb_2));
    in(att,cypher7_2:bitstring);
    let (=s6, =Mb_2)=sdec(cypher7_2, Kab_2) in
    0.
let Server(Kas_2:bitstring, Kbs_2:bitstring, idA_2:bitstring,
           idB_2:bitstring)=
    in(att,(=idB_2, (Nb_2:bitstring, cypher5_2:bitstring)));
    let mess3_2:bitstring=sdec(cypher5_2, Kbs_2) in
    let (=s1, (=idA_2, (Na_2:bitstring, Tb_2:bitstring)))=mess3_2 in
    event eIN_S_1( cypher5_2, (Na_2, Tb_2) );
    new Kab_2:bitstring;
    event eServer( idA_2, idB_2, (Kab_2, (Na_2, Nb_2)) );
    let subpart1_2:bitstring=senc((s2, (idB_2, (Na_2, (Kab_2, Tb_2)))),
                                  Kas_2) in
    event eOUT_S_2( subpart1_2 );
    let subpart2_2:bitstring=senc((s3, (idA_2, (Kab_2, Tb_2))), Kbs_2) in
    out(att,(subpart1_2, (subpart2_2, Nb_2))).
let CompromiseLtk(s_2:bitstring)=
    event eCompromise( id(s_2) );
    out(att,s_2).
process
    !
    (new Kas_2:bitstring;
     new Kbs_2:bitstring;
     out(att,id(Kas_2));
     out(att,id(Kbs_2));
     ((((CompromiseLtk(Kas_2))
      | (CompromiseLtk(Kbs_2))))
    | (((((!
           (Alice(Kas_2, id(Kas_2), id(Kbs_2))))
        | (!
           (Bob(Kbs_2, id(Kas_2), id(Kbs_2))))))
      | (!
         (Server(Kas_2, Kbs_2, id(Kas_2), id(Kbs_2))))))))

