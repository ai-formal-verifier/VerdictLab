  "names": {
    "A": "The initiator, sharing master key K_as with S, and its identity A sent in message 1 and inside both credentials (§2, §3, §4).",
    "B": "The responder, sharing master key K_bs with S, and its identity B sent in message 1 and inside both credentials (§2, §3, §4).",
    "K_as": "The master key shared between principal A and the server S (§3, §5).",
    "K_bs": "The master key shared between principal B and the server S (§3, §5).",
    "S": "The principal S: the trusted authentication server: shares long-term master keys with A and B, generates the session key, and encrypts credentials for both principals.",
    "K_ab": "The session key S generates and places in both credentials of message 2 (§3, §4).",
    "N_a": "The nonce A generates and sends to S in message 1, carried in both credentials and returned by B encrypted under K_ab in message 3 (§3, §4).",
    "N_b": "The nonce B generates and sends in the clear to A in message 3, returned by A encrypted under K_ab in message 4 (§3, §4)."
  },
