(* ============================================================
   Kao-Chow Authentication (P variant) — ProVerif standard.
   Provenance: mechanically exported from the SAPIC+ Tamarin model
   `kao-chow-P.spthy` via `tamarin-prover -m=proverif`.
   The exported reachability PROCESS is used as-is. The security
   QUERIES were rewritten into ProVerif idiom (injective agreement ->
   inj-event; secrecy -> attacker()) because the SAPIC+ export does
   not translate Tamarin's injective / secrecy / exists-trace lemma
   shapes. Verdicts (against this file) are recorded in ../../results.json.
   ============================================================ *)

free att:channel.
free s1:bitstring.
free s2:bitstring.
free s3:bitstring.
free s4:bitstring.
free s5:bitstring.
fun fst(bitstring):bitstring.
fun id(bitstring):bitstring.
fun pair(bitstring,bitstring):bitstring.
fun sdec(bitstring,bitstring):bitstring.
fun senc(bitstring,bitstring):bitstring.
fun snd(bitstring):bitstring.
event eCommitA(bitstring,bitstring,bitstring).
event eCommitB(bitstring,bitstring,bitstring).
event eCompromise(bitstring).
event eIN_A_1(bitstring,bitstring).
event eIN_B_Na(bitstring,bitstring).
event eOUT_B_1(bitstring).
event eOUT_S_1(bitstring).
event eOut_A_Na(bitstring).
event eRunningA(bitstring,bitstring,bitstring).
event eRunningB(bitstring,bitstring,bitstring).
event eSecret(bitstring,bitstring,bitstring).
equation forall x_1:bitstring, x_2:bitstring;   fst((x_1, x_2)) = x_1.
equation forall x_1:bitstring, x_2:bitstring;   sdec(senc(x_1, x_2), x_2) = x_1.
equation forall x_1:bitstring, x_2:bitstring;   snd((x_1, x_2)) = x_2.


(* === Security queries (ProVerif idiom: inj-event for injective agreement, attacker() for secrecy) === *)

(* Secrecy of session key Kab, unless one of the long-term keys is compromised *)
query a:bitstring, b:bitstring, k:bitstring;
  (event(eSecret(a,b,k)) && attacker(k)) ==> (event(eCompromise(a)) || event(eCompromise(b))).

(* Non-injective agreement, B's view *)
query a:bitstring, b:bitstring, t:bitstring;
  event(eCommitB(b,a,t)) ==> event(eRunningA(a,b,t)) || event(eCompromise(a)) || event(eCompromise(b)).

(* Non-injective agreement, A's view *)
query a:bitstring, b:bitstring, t:bitstring;
  event(eCommitA(a,b,t)) ==> event(eRunningB(b,a,t)) || event(eCompromise(a)) || event(eCompromise(b)).

(* Injective agreement, B's view *)
query a:bitstring, b:bitstring, t:bitstring;
  inj-event(eCommitB(b,a,t)) ==> inj-event(eRunningA(a,b,t)) || event(eCompromise(a)) || event(eCompromise(b)).

(* Injective agreement, A's view *)
query a:bitstring, b:bitstring, t:bitstring;
  inj-event(eCommitA(a,b,t)) ==> inj-event(eRunningB(b,a,t)) || event(eCompromise(a)) || event(eCompromise(b)).

let A(Kas_2:bitstring, idA_2:bitstring, idB_2:bitstring)=
    new Na_2:bitstring;
    event eOut_A_Na( Na_2 );
    out(att,(s1, (idA_2, (idB_2, Na_2))));
    in(att,cypher_2:bitstring);
    let (package1_2:bitstring, (message_2:bitstring, Nb_2:bitstring))=cypher_2 in
    let (=s2, (=idA_2, (=idB_2, (=Na_2, Kab_2:bitstring))))=sdec(package1_2,
                                                                 Kas_2) in
    let (=s4, =Na_2)=sdec(message_2, Kab_2) in
    event eIN_A_1( cypher_2, Nb_2 );
    event eSecret( idA_2, idB_2, Kab_2 );
    event eCommitA( idA_2, idB_2, (Na_2, (Nb_2, Kab_2)) );
    event eRunningA( idA_2, idB_2, (Na_2, (Nb_2, Kab_2)) );
    out(att,senc((s5, Nb_2), Kab_2)).
let B(Kbs_2:bitstring, idA_2:bitstring, idB_2:bitstring)=
    in(att,cypher_2:bitstring);
    let (package1_2:bitstring, package2_2:bitstring)=cypher_2 in
    let (=s3, (=idA_2, (=idB_2, (Na_2:bitstring, Kab_2:bitstring))))=sdec(package2_2,
                                                                          Kbs_2) in
    event eSecret( idA_2, idB_2, Kab_2 );
    new Nb_2:bitstring;
    event eIN_B_Na( cypher_2, Na_2 );
    event eOUT_B_1( (package1_2, (senc((s4, Na_2), Kab_2), Nb_2)) );
    event eRunningB( idB_2, idA_2, (Na_2, (Nb_2, Kab_2)) );
    out(att,(package1_2, (senc((s4, Na_2), Kab_2), Nb_2)));
    in(att,cypher2_2:bitstring);
    let (=s5, =Nb_2)=sdec(cypher2_2, Kab_2) in
    event eCommitB( idB_2, idA_2, (Na_2, (Nb_2, Kab_2)) ).
let S(Kas_2:bitstring, Kbs_2:bitstring, idA_2:bitstring,
      idB_2:bitstring)=
    in(att,(=s1, (=idA_2, (=idB_2, Na_2:bitstring))));
    new Kab_2:bitstring;
    let package1_2:bitstring=senc((s2, (idA_2, (idB_2, (Na_2, Kab_2)))),
                                  Kas_2) in
    let package2_2:bitstring=senc((s3, (idA_2, (idB_2, (Na_2, Kab_2)))),
                                  Kbs_2) in
    event eSecret( idA_2, idB_2, Kab_2 );
    event eOUT_S_1( (package1_2, package2_2) );
    out(att,(package1_2, package2_2)).
let CompromiseLtk(s_2:bitstring)=
    event eCompromise( id(s_2) );
    out(att,s_2).
process
    !
    (new Kas_2:bitstring;
     new Kbs_2:bitstring;
     out(att,id(Kas_2));
     out(att,id(Kbs_2));
     ((((CompromiseLtk(Kas_2))
      | (CompromiseLtk(Kbs_2))))
    | (((((!
           (A(Kas_2, id(Kas_2), id(Kbs_2))))
        | (!
           (B(Kbs_2, id(Kas_2), id(Kbs_2))))))
      | (!
         (S(Kas_2, Kbs_2, id(Kas_2), id(Kbs_2))))))))
