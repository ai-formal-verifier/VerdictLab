{
  "vocab_version": "4.0.0",
  "protocol_id": "NSPK",
  "names": {
    "A": "The initiator, holding key pair (SKA, PKA), and its identity A, which it names in message 1 and sends inside message 3 (§2, §3, §4).",
    "B": "The responder, holding key pair (SKB, PKB), and its identity B, which A names in message 1 as the peer to authenticate and which S returns in message 2 (§2, §3, §4).",
    "PKA": "A's public key, which S returns to B signed together with identity A in message 5 ({PKA, A}SKas) and which B uses to encrypt message 6 (§3, §4).",
    "PKB": "B's public key, which S returns to A signed together with identity B in message 2 ({PKB, B}SKas) and which A uses to encrypt messages 3 and 7 (§3, §4).",
    "PKas": "The authentication server's public signing key, which A and B hold and use to verify the bindings S signs with SKas (§2, §3).",
    "peer_auth": "The identity scope of the principals registered with S, among which an initiator selects its peer; closed means only the honest peers are registered, open that the attacker may register a recognised principal (§2, §5).",
    "I_A": "The random number (nonce) generated by A and sent to B in message 3, returned by B in message 6 (§3, §4).",
    "I_B": "The random number (nonce) generated by B and sent to A in message 6, returned by A in message 7 (§3, §4)."
  },
