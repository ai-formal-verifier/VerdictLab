{
  "vocab_version": "4.0.0",
  "protocol_id": "Denning-Sacco",
  "names": {
    "A": "The participant that initiates the session-key request to S in message 1, and its identity A carried in the ticket (§2, §3, §4).",
    "B": "The intended communication partner of A, who receives the ticket {Kab, A, T}Ksb in message 3, and its identity B named in message 1 (§2, §3, §4).",
    "Ksa": "The secret symmetric key shared exclusively between A and the server S (§3, §5).",
    "Ksb": "The secret symmetric key shared exclusively between B and the server S (§3, §5).",
    "S": "The trusted server that generates the session key Kab and timestamp T and sends them to A in message 2 (§2, §3, §4).",
    "Kab": "The fresh session key the server S generates and sends to A in message 2, and that B obtains from the ticket in message 3 (§3, §4).",
    "T": "The timestamp generated by S, indicating the validity of Kab, carried in message 2 and in the ticket forwarded to B in message 3 (§3, §4)."
  },
