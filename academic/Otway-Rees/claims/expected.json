  "names": {
    "peer_auth": "The identity scope of the peer identities honest principals can select; open means the attacker may register a recognised peer identity (§5).",
    "A": "The initiator, sharing K_as with S, and its identity A carried in messages 1 and 2 (§2, §3, §4).",
    "B": "The responder, sharing K_bs with S, and its identity B carried in messages 1 and 2 (§2, §3, §4).",
    "K_as": "The symmetric key shared between A and S (§3, §5).",
    "K_bs": "The symmetric key shared between B and S (§3, §5).",
    "K_ab": "The session key the server S generates and sends to B in message 3, which B forwards to A in message 4 (§3, §4)."
  },
