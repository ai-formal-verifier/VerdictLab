  "names": {
    "peer_auth": "The identity scope of the peer identities honest principals can select; open means the attacker may register a recognised peer identity (§5).",
    "A": "The initiator, sharing K_as with S, and its identity A sent in step 1 and inside the ticket {A, K_ab}K_bs (§2, §3, §4).",
    "B": "The responder, sharing K_bs with S, and its identity B sent to S in step 2 and returned to A in step 3 (§2, §3, §4).",
    "K_as": "The master key shared between A and S (§3, §5).",
    "K_bs": "The master key shared between B and S (§3, §5).",
    "K_ab": "The session key the server S generates and sends to A in step 3, inside A's part and the ticket A forwards to B in step 4 (§3, §4)."
  },
