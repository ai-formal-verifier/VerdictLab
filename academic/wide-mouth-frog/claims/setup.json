{
  "vocab_version": "4.0.0",
  "names": {
    "A": "The initiator, sharing K_as with S, who chooses the session key, and its identity A sent in message 1 and forwarded to B in message 2 (§2, §3, §4).",
    "B": "The recipient of the session key, sharing K_bs with S, and its identity B inside message 1 (§2, §3, §4).",
    "K_as": "The key A shares with the server S (§3, §5).",
    "K_bs": "The key B shares with the server S (§3, §5).",
    "S": "The trusted authentication server that receives message 1 from A and forwards the key to B in message 2 (§2, §4).",
    "K_ab": "The session key chosen by A and sent to S in message 1, which S forwards to B in message 2 (§3, §4)."
  },
